  <exercise xml:id="03-review-questions-4">
    <statement>
      <p>Factorise:</p>

      <p>
        <ol>
          <li>
            <p><m>x^3 + 5x^2 + 2x - 8</m></p>
          </li>
          <li>
            <p><m>2x^3 + 3x^2 - 17x - 30</m></p>
          </li>
          <li>
            <p><m>4x^3 - 4x^2 - 11x + 6</m></p>
          </li>
          <li>
            <p><m>6x^3 + 13x^2 - 4</m></p>
          </li>
          <li>
            <p><m>3x^3 + 16x^2 - 13x - 6</m></p>
          </li>
        </ol>
      </p>
    </statement>
    <answer>
      <p>
        <ol>
          <li>
            <p><m>(x - 1)(x + 2)(x + 4)</m></p>
          </li>
          <li>
            <p><m>(x + 2)(2x + 5)(x - 3)</m></p>
          </li>
          <li>
            <p><m>(x - 2)(2x - 1)(2x + 3)</m></p>
          </li>
          <li>
            <p><m>(x + 2)(3x + 2)(2x - 1)</m></p>
          </li>
          <li>
            <p><m>(x - 1)(3x + 1)(x + 6)</m></p>
          </li>
        </ol>
      </p>
    </answer>
  </exercise>

  <exercise xml:id="03-review-questions-5">
    <statement>
      <p>Find the zeros of the following:</p>

      <p>
        <ol>
          <li>
            <p><m>x^3 + 4x^2 + x - 6</m></p>
          </li>
          <li>
            <p><m>2x^3 + 7x^2 - 14x + 5</m></p>
          </li>
          <li>
            <p><m>2x^3 + x^2 - 5x + 2</m></p>
          </li>
          <li>
            <p><m>4x^3 - 8x^2 - 9x + 18</m></p>
          </li>
          <li>
            <p><m>4x^3 - 4x^2 - x + 1</m></p>
          </li>
          <li>
            <p><m>4x^3 - 12x^2 + 11x - 3</m></p>
          </li>
        </ol>
      </p>
    </statement>
    <answer>
      <p>
        <ol>
          <li>
            <p><m>x = 1, -3, -2</m></p>
          </li>
          <li>
            <p><m>x = -5, 1, 0.5</m></p>
          </li>
          <li>
            <p><m>x = -2, 1, 0.5</m></p>
          </li>
          <li>
            <p><m>x = -1.5, 1.5, 2</m></p>
          </li>
          <li>
            <p><m>x = -0.5, 1, 0.5</m></p>
          </li>
          <li>
            <p><m>x = 1, 0.5, 1.5</m></p>
          </li>
        </ol>
      </p>
    </answer>
  </exercise>

  <exercise xml:id="03-review-questions-6">
    <statement>
      <p>Find the roots of:</p>

      <p>
        <ol>
          <li>
            <p><m>x^3 + 6x</m></p>
          </li>
          <li>
            <p><m>2x^4 + 17x^2 + 35</m></p>
          </li>
          <li>
            <p><m>x^4 - 14x^2 + 36</m></p>
          </li>
          <li>
            <p><m>x^4 - 1</m></p>
          </li>
          <li>
            <p><m>x^3 + 27x</m></p>
          </li>
        </ol>
      </p>

      <!-- div center -->

      <image source="figures/rq3-7.png" width="65%">
        <shortdescription>image</shortdescription>
      </image>

      <!-- end div center -->
    </statement>
    <answer>
      <p>
        <ol>
          <li>
            <p><m>0, i\sqrt{6}, -i\sqrt{6}</m></p>
          </li>
          <li>
            <p>
              <m>i\sqrt{\frac{7}{2}}, -i\sqrt{\frac{7}{2}}, -i\sqrt{5},
              i\sqrt{5}</m>
            </p>
          </li>
          <li>
            <p>
              <m>-\sqrt{7 + \sqrt{13}}, \sqrt{7 + \sqrt{13}}, -\sqrt{7 -
              \sqrt{13}}, \sqrt{7 - \sqrt{13}}</m>
            </p>
          </li>
          <li>
            <p><m>1, -1, i, -i</m></p>
          </li>
          <li>
            <p><m>0, 3i\sqrt{3}, -3i\sqrt{3}</m></p>
          </li>
        </ol>
      </p>
    </answer>
  </exercise>

  <exercise xml:id="03-review-questions-7">
    <statement>
      <p>
        Find the polynomial function f(x) as represented by the curve above.
      </p>
    </statement>
    <answer>
      <p><m>f(x) = x^3 - 5x^2 - 6x</m></p>
    </answer>
  </exercise>

  <exercise xml:id="03-review-questions-8">
    <statement>
      <p>
        <m>Q(x) = 10x^3 + ax^2 - 10x + b</m>, where <m>a</m> and <m>b</m>
        are integers, is divisible by <m>(2x + 1)</m>. When <m>Q(x)</m> is
        divided by <m>x + 1</m>, the remainder is -2.
      </p>

      <p>
        <ol>
          <li>
            <p>Find the values of a and of b</p>
          </li>
          <li>
            <p>
              find the expression for <m>Q(x)</m> as a product of the three
              linear factors
            </p>
          </li>
        </ol>
      </p>
    </statement>
    <answer>
      <p>
        <ol>
          <li>
            <p>a <m>=</m> 11, b <m>=</m> 6</p>
          </li>
          <li>
            <p><m>(2x + 1)(x + 2)(x + 3)</m></p>
          </li>
        </ol>
      </p>
    </answer>
  </exercise>

  <exercise xml:id="03-review-questions-9">
    <statement>
      <p>
        Given that <m>x_1 = 1 + \sqrt{2}\,i</m> and <m>x_2 = 2 + 3i</m> are
        roots of a polynomial function <m>P(x)</m>, determine the <m>P(x) =
        0</m>
      </p>
    </statement>
    <answer>
      <p><m>f(x) = x^4 - 6x^3 + 24x^2 - 38x + 29</m></p>
    </answer>
  </exercise>

  <exercise xml:id="03-review-questions-10">
    <statement>
      <p>
        Applying Descartes' Rule of Signs, identify the potential number of
        positive and negative roots.
      </p>

      <p>
        <ol>
          <li>
            <p><m>f(x) = 10x^6 - 5x^5 + 3x^4 - 6x^3 + 24x^2 - 38x</m></p>
          </li>
          <li>
            <p><m>f(x) = 19x^5 + 6x^4 + 17x^3 + 18x^2 - 38x - 70</m></p>
          </li>
          <li>
            <p><m>f(x) = x^6 - 729</m></p>
          </li>
          <li>
            <p><m>f(x) = 12x^6 + 13x^3 + 1</m></p>
          </li>
          <li>
            <p><m>f(x) = 8x^8 - 13x^4 + 100</m></p>
          </li>
        </ol>
      </p>
    </statement>
    <answer>
      <p>
        <ol>
          <li>
            <p>
              Positive zeros<term>:</term> 5, 3, or 1, Negative
              zeros<term>:</term> 0
            </p>
          </li>
          <li>
            <p>
              Possible Positive Zeros<term>:</term> 1, Possible Negative
              Zeros<term>:</term> 4, 2, or 0
            </p>
          </li>
          <li>
            <p>
              Possible Positive Zeros<term>:</term> 1, Possible Negative
              Zeros<term>:</term> 1
            </p>
          </li>
          <li>
            <p>
              Possible Positive Zeros<term>:</term> 0, Possible Negative
              Zeros<term>:</term> 2 or 0
            </p>
          </li>
          <li>
            <p>
              Possible Positive Zeros<term>:</term> 2 or 0, Possible Negative
              Zeros<term>:</term> 2 or 0
            </p>
          </li>
        </ol>
      </p>
    </answer>
  </exercise>

  <exercise xml:id="03-review-questions-11">
    <statement>
      <p>Write down the equation having only the following roots.</p>

      <p>
        <ol>
          <li>
            <p>-5 , -1, 3</p>
          </li>
          <li>
            <p><m>3, -\frac{1}{5}, -\frac{1}{3}</m></p>
          </li>
          <li>
            <p>2, -2, <m>2 + \sqrt{3}</m>, <m>2 - \sqrt{3}</m></p>
          </li>
          <li>
            <p>0, 1 <m>+</m> 4i, 1- 4i</p>
          </li>
        </ol>
      </p>
    </statement>
    <answer>
      <p>
        <ol>
          <li>
            <p><m>x^3 + 3x^2 - 13x - 15</m></p>
          </li>
          <li>
            <p><m>15x^3 - 37x^2 - 23x - 3</m></p>
          </li>
          <li>
            <p><m>x^4 - 8x^2 + 16</m></p>
          </li>
          <li>
            <p><m>x^3 - 2x^2 + 17x</m></p>
          </li>
        </ol>
      </p>
    </answer>
  </exercise>

  <exercise xml:id="03-review-questions-12">
    <statement>
      <p>Find the four roots of <m>x^4 + 3x^2 + 2</m></p>
    </statement>
    <answer>
      <p><m>i, -i, i\sqrt{2}, -i\sqrt{2}</m></p>
    </answer>
  </exercise>

  <exercise xml:id="03-review-questions-13">
    <statement>
      <p>
        Study the graph below and use it to answer the following questions:
      </p>

      <p>
        <ol>
          <li>
            <p>state the factors</p>
          </li>
          <li>
            <p>find the polynomial function</p>
          </li>
          <li>
            <p>how many turning points</p>
          </li>
          <li>
            <p>
              what is the relationship between the degree of the function
              and the number of turning points
            </p>
          </li>
        </ol>
      </p>

      <!-- div center -->

      <image source="figures/rq3-13.png" width="65%">
        <shortdescription>image</shortdescription>
      </image>

      <!-- end div center -->
    </statement>
    <answer>
      <p>
        <ol>
          <li>
            <p><m>(x + 1)(x + 2)(x + 3)(x - 1)(x - 2)</m></p>
          </li>
          <li>
            <p><m>x^5 + 3x^4 - 5x^3 - 15x^2 + 4x + 12</m></p>
          </li>
          <li>
            <p>4 turning points</p>
          </li>
          <li>
            <p>
              degree reduced by 1 gives the maximum number of turning points
            </p>
          </li>
        </ol>
      </p>
    </answer>
  </exercise>

  <exercise xml:id="03-review-questions-14">
    <statement>
      <p>
        A new bakery in Accra specialises in creating various types of
        bread. The bakery wants the volume of a small rectangular loaf of
        bread to be 4 800 cm<m>^3</m>. The loaf is to be shaped like a
        rectangular solid. The length of the loaf is to be 4cm longer than
        the width. The height of the loaf is one-half of the width.
        Determine the dimensions of the loaf.
      </p>
    </statement>
    <answer>
      <p>
        Width <m>=</m> 20 cm, Length <m>=</m> 24cm and Height <m>=</m> 10 cm.
      </p>
    </answer>
  </exercise>
</section>
