<section xml:id="03-review-questions">
  <title>Review Questions</title>

  <exercise xml:id="03-review-questions-1">
    <statement>
      <p>
        Use the Rational Zero Theorem to find the rational zeros
        of<term>:</term>
      </p>

      <p>
        <ol>
          <li>
            <p><m>6x^3 - 13x^2 - 14x - 3</m></p>
          </li>
          <li>
            <p><m>5x^3 + 2x^2 - 5x - 2</m></p>
          </li>
        </ol>
      </p>

      <!-- div center -->

      <image source="figures/rq3-2.png" width="70%">
        <shortdescription>image</shortdescription>
      </image>

      <!-- end div center -->
    </statement>
    <answer>
      <p>
        <ol>
          <li>
            <p><m>x = 3, -\frac{1}{3}, -\frac{1}{2}</m></p>
          </li>
          <li>
            <p><m>x = 1, -\frac{2}{5}, -1</m></p>
          </li>
        </ol>
      </p>
    </answer>
  </exercise>

  <exercise xml:id="03-review-questions-2">
    <statement>
      <p>
        Carefully, study the graph above which represents a polynomial
        function f(x).
      </p>

      <p>
        <ol>
          <li>
            <p>State the zeros</p>
          </li>
          <li>
            <p>Find the factors</p>
          </li>
          <li>
            <p>State the interval on the curve.</p>
          </li>
          <li>
            <p>Find the polynomial function f(x)</p>
          </li>
        </ol>
      </p>
    </statement>
    <answer>
      <p>
        <ol>
          <li>
            <p>the zeros are -1, 0.5. and 3</p>
          </li>
          <li>
            <p>the factors are <m>(x + 1)\,(2x\text{-}1)\,(x\text{-}3)</m></p>
          </li>
          <li>
            <p>
              <ndash/>1 <m>&gt;</m> x, <ndash/>1 <m>&lt;</m> x <m>&lt;</m>
              0.5, 0.5 <m>&lt;</m> x <m>&lt;</m> 3, x <m>&gt;</m> 3
            </p>
          </li>
          <li>
            <p><m>f(x) = 2x^3 - 5x^2 - 4x + 3</m></p>
          </li>
        </ol>
      </p>
    </answer>
  </exercise>

